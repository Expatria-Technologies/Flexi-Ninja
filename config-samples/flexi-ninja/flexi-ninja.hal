loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS

#Load HAL components
   loadrt flexi-ninja
   loadrt estop_latch names=estop_latch
   loadrt and2 names=run_and,step_and
   loadrt toggle names=hold_button_toggle
   loadrt toggle2nist names=hold_toggle,paused_toggle

#Add HAL components to thread
   addf motion-command-handler servo-thread
   addf flexi-ninja.watchdog-process servo-thread
   addf flexi-ninja.process-send servo-thread
   addf flexi-ninja.process-recv servo-thread
   addf motion-controller servo-thread
   addf estop_latch servo-thread
   addf run_and servo-thread
   addf step_and servo-thread
   addf hold_toggle servo-thread
   addf hold_button_toggle servo-thread

# Toggle2nist states & mux selectors
   net program-is-paused hold_toggle.is-on <= halui.program.is-paused

# Spindle Control
   # VFD via vfdmod. Comment this out if using hy_vfd.
   loadusr -W vfdmod vfdmod.ini
   loadrt scale names=spindle_fb_scale
   addf spindle_fb_scale servo-thread
   setp spindle_fb_scale.gain 0.016666667
   net spindle-speed-cmd vfdmod.spindle.rpm-in <= spindle.0.speed-out
   net spindle-fb-scale-in vfdmod.spindle.rpm-out => spindle_fb_scale.in
   net spindle-speed-fb spindle_fb_scale.out => spindle.0.speed-in
   net spindle-at-speed vfdmod.spindle.at-speed => spindle.0.at-speed
   net spindle-forward vfdmod.control.run-forward => spindle.0.forward
   net spindle-reverse vfdmod.control.run-reverse => spindle.0.reverse

   # hy_vfd - uncomment the below if using hy_vfd. Use ttyAMA3 for Pi 4 and ttyAMA2 for Pi 5
	#loadusr -Wn vfd hy_vfd -n vfd -d /dev/ttyAMA2 -p none -r 9600 -s 1
	#loadrt scale names=spindle_fb_scale
	#addf spindle_fb_scale servo-thread
	#setp spindle_fb_scale.gain 0.016666667 # 1/60  to convert rpm to rps for qtdrangon_hd
	#setp vfd.enable 1
	#net spindle-speed-cmd vfd.speed-command <= spindle.0.speed-out
	#net spindle-fb-scale-in vfd.spindle-speed-fb => spindle_fb_scale.in
	#net spindle-speed-fb spindle_fb_scale.out => spindle.0.speed-in
	#net spindle-at-speed vfd.spindle-at-speed => spindle.0.at-speed
	#net spindle-forward vfd.spindle-forward => spindle.0.forward
	#net spindle-reverse vfd.spindle-reverse => spindle.0.reverse
	#net spindle-on vfd.spindle-on => spindle.0.on
	#net spindle-comm-ok <= vfd.hycomm-ok

   # Analog spindle control - Uncomment if using PWM or analog. You will also need to comment out spindle feedback qtdragon_hd.hal.
   #loadrt scale names=spindle_speed_scale
   #loadrt conv_float_u32 names=spindle_speed_scale_u32
   #loadrt scale names=spindle_fb_scale
   #addf spindle_speed_scale servo-thread
   #addf spindle_speed_scale_u32 servo-thread
   #addf spindle_fb_scale servo-thread
   #setp spindle_fb_scale.gain 0.016666667 # 1/60  to convert rpm to rps for qtdrangon_hd
   #setp spindle_speed_scale.gain 0.170667 # Desired output range is 0-4096. For 24000rpm spindle, (4096/24000) scale = 0.170667.
   #net spindle-scale-in spindle.0.speed-out-abs => spindle_speed_scale.in 
   #net spindle-scale-u32-in spindle_speed_scale.out => spindle_speed_scale_u32.in
   #net spindle-speed-scaled spindle_speed_scale_u32.out => flexi-ninja.SPINDLE_PWM.duty
   #net spindle-enable spindle.0.on => flexi-ninja.output.SPINDLE_ENABLE flexi-ninja.SPINDLE_PWM.enable spindle.0.at-speed
   #net spindle-scale-in => spindle_fb_scale.in
   #net spindle-speed-fb spindle_fb_scale.out => spindle.0.speed-in

# E-stop loop: HALT and comms status
   net user-enable-out iocontrol.0.user-enable-out => flexi-ninja.io-ready-in
   net user-request-enable iocontrol.0.user-request-enable => estop_latch.reset
   net halt-fault flexi-ninja.input.HALT-not => estop_latch.fault-in
   net comms-ok flexi-ninja.connected => estop_latch.ok-in
   net linuxcnc-enable estop_latch.ok-out => iocontrol.0.emc-enable-in

# Joint 0 - X axis
   setp flexi-ninja.stepgen.0.step-scale [JOINT_0]SCALE
   setp flexi-ninja.stepgen.0.dir-setup [JOINT_0]DIR_SETUP
   net Xpos-cmd joint.0.motor-pos-cmd => flexi-ninja.stepgen.0.command
   net Xpos-fb flexi-ninja.stepgen.0.feedback => joint.0.motor-pos-fb
   net X-enable joint.0.amp-enable-out => flexi-ninja.stepgen.0.enable
   net X-home joint.0.home-sw-in <= flexi-ninja.input.X_LIM-not

# Joint 1 - Y axis
   setp flexi-ninja.stepgen.1.step-scale [JOINT_1]SCALE
   setp flexi-ninja.stepgen.1.dir-setup [JOINT_1]DIR_SETUP
   net Ypos-cmd joint.1.motor-pos-cmd => flexi-ninja.stepgen.1.command
   net Ypos-fb flexi-ninja.stepgen.1.feedback => joint.1.motor-pos-fb
   net Y-enable joint.1.amp-enable-out => flexi-ninja.stepgen.1.enable
   net Y-home joint.1.home-sw-in <= flexi-ninja.input.Y_LIM-not

# Joint 2 - Z axis
   setp flexi-ninja.stepgen.2.step-scale [JOINT_2]SCALE
   setp flexi-ninja.stepgen.2.dir-setup [JOINT_2]DIR_SETUP
   net Zpos-cmd joint.2.motor-pos-cmd => flexi-ninja.stepgen.2.command
   net Zpos-fb flexi-ninja.stepgen.2.feedback => joint.2.motor-pos-fb
   net Z-enable joint.2.amp-enable-out => flexi-ninja.stepgen.2.enable
   net Z-home joint.2.home-sw-in <= flexi-ninja.input.Z_LIM-not

# Joint 3 - second Y axis
   setp flexi-ninja.stepgen.3.step-scale [JOINT_3]SCALE
   setp flexi-ninja.stepgen.3.dir-setup [JOINT_3]DIR_SETUP
   net Apos-cmd joint.3.motor-pos-cmd => flexi-ninja.stepgen.3.command
   net Apos-fb flexi-ninja.stepgen.3.feedback => joint.3.motor-pos-fb
   net A-enable joint.3.amp-enable-out => flexi-ninja.stepgen.3.enable
   net A-home joint.3.home-sw-in <= flexi-ninja.input.A_LIM-not

# Joint 4 - commented out (5th axis)
   # setp flexi-ninja.stepgen.4.step-scale [JOINT_4]SCALE
   # net Bpos-cmd joint.4.motor-pos-cmd => flexi-ninja.stepgen.4.command
   # net Bpos-fb flexi-ninja.stepgen.4.feedback => joint.4.motor-pos-fb
   # net B-enable joint.4.amp-enable-out => flexi-ninja.stepgen.4.enable
   # net B-home joint.4.home-sw-in <= flexi-ninja.input.B_LIM-not

# Pulse width from INI
   setp flexi-ninja.stepgen.pulse-width [FLEXI_NINJA]PULSE_WIDTH

# Motor enable outputs to board (non-inverted)
   net X-enable => flexi-ninja.output.X_EN
   net Y-enable => flexi-ninja.output.Y_EN
   net Z-enable => flexi-ninja.output.Z_EN
   net A-enable => flexi-ninja.output.A_EN

# Flood and mist coolant
   net flood flexi-ninja.output.COOL <= iocontrol.0.coolant-flood
   net mist flexi-ninja.output.MIST <= iocontrol.0.coolant-mist

# Feed hold toggle logic
   net hold-button flexi-ninja.input.FEED_HOLD => hold_button_toggle.in
   net hold-toggle-latch hold_button_toggle.out => hold_toggle.in
   net hold-on halui.program.pause <= hold_toggle.on
   net hold-off halui.program.resume <= hold_toggle.off

# Cycle start logic
   net run-step-button flexi-ninja.input.CYCLE_START => run_and.in0 step_and.in0
   net program-is-idle halui.program.is-idle => run_and.in1
   net program-run run_and.out => halui.program.run
   net program-is-paused => step_and.in1
   net single-step step_and.out => halui.program.step

# Probe input - TODO, use the mask switching and IRQ properly.
   net probe-input motion.probe-input <= flexi-ninja.input.PROBE

# Tool Change
   # These are for axis, uncomment these and remove 'source qtdragon_hd.hal' from postgui_call_list.hal if using axis GUI.
   #loadusr -W hal_manualtoolchange
   #net tool-change iocontrol.0.tool-change => hal_manualtoolchange.change
   #net tool-changed iocontrol.0.tool-changed <= hal_manualtoolchange.changed
   #net tool-number iocontrol.0.tool-prep-number => hal_manualtoolchange.number
   #net tool-prepare-loopback iocontrol.0.tool-prepare => iocontrol.0.tool-prepared

   # This is for qtdradon_hd, comment out of using axis.
   net tool-prepare-loopback iocontrol.0.tool-prepare => iocontrol.0.tool-prepared
