loadrt flexi-ninja-eth ip_address="192.168.0.177:8888"
 
addf flexi-ninja-eth.watchdog-process servo-thread
addf flexi-ninja-eth.process-send servo-thread
addf flexi-ninja-eth.process-recv servo-thread

net estop-loop-in iocontrol.0.user-enable-out flexi-ninja-eth.io-ready-in 
net estop-loop-out iocontrol.0.emc-enable-in flexi-ninja-eth.io-ready-out

net Xpos flexi-ninja-eth.stepgen.0.command
net Ypos flexi-ninja-eth.stepgen.1.command
net Zpos flexi-ninja-eth.stepgen.2.command

setp flexi-ninja-eth.stepgen.0.step-scale [JOINT_0]INPUT_SCALE
setp flexi-ninja-eth.stepgen.1.step-scale [JOINT_1]INPUT_SCALE
setp flexi-ninja-eth.stepgen.2.step-scale [JOINT_2]INPUT_SCALE

setp flexi-ninja-eth.encoder.ENC1.scale 0.25
setp flexi-ninja-eth.encoder.ENC2.scale 0.25
setp flexi-ninja-eth.encoder.ENC3.scale 0.25

setp axis.x.jog-scale 0.01
setp axis.y.jog-scale 0.01
setp axis.z.jog-scale 0.01

net encoder-counts <= flexi-ninja-eth.encoder.0.scaled-count
net encoder-counts => axis.x.jog-counts
net encoder-counts => axis.y.jog-counts
net encoder-counts => axis.z.jog-counts
